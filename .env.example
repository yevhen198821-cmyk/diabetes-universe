# Diabetes Universe — environment contract
#
# The web application boots without auth secrets for local Timeline/Dashboard usage.
# Authentication routes require the server-only variables in the P6 section below.
#
# ---------------------------------------------------------------------------
# Public variables (client-safe)
# Never place secrets in NEXT_PUBLIC_* variables.
#
# NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# ---------------------------------------------------------------------------
# P6 authentication (server-only)
# Required for /auth, /api/auth/*, and /account when auth is enabled.
# Do not commit real values. Configure separately for local, Preview, and Production.
#
# DATABASE_URL=postgresql://user:password@host:5432/diabetes_universe_auth
# BETTER_AUTH_SECRET=                         # openssl rand -base64 32
# BETTER_AUTH_URL=http://localhost:3000
# AUTH_EMAIL_FROM=auth@your-verified-domain.example
# RESEND_API_KEY=
#
# Production launch requires a verified custom sending domain in Resend.
# Engineering validation may temporarily use onboarding@resend.dev.
# AUTH_TRUSTED_ORIGINS=http://localhost:3000
#
# Optional WebAuthn (future slices / production enrollment)
# AUTH_WEBAUTHN_RP_ID=localhost
# AUTH_WEBAUTHN_RP_NAME=Diabetes Universe
# AUTH_WEBAUTHN_ORIGIN=http://localhost:3000
#
# Local/CI test database (no external Postgres required)
# AUTH_DATABASE_MODE=pglite
# AUTH_USE_PGLITE=true
#
# Local/CI test database (no external Postgres required)
# MEDICAL_DATABASE_MODE=pglite
# MEDICAL_USE_PGLITE=true
#
# ---------------------------------------------------------------------------
# P9 medical persistence (server-only)
# Required for production-capable medical persistence runtime.
# Do not commit real values. Separate from Better Auth DATABASE_URL.
#
# MEDICAL_DATABASE_URL=postgresql://medical_app@host:5432/diabetes_universe_medical
# MEDICAL_MIGRATOR_DATABASE_URL=postgresql://medical_migrator@host:5432/diabetes_universe_medical
# MEDICAL_REVISION_TOKEN_SECRET=                 # openssl rand -base64 32
# MEDICAL_LIST_CURSOR_SECRET=                    # openssl rand -base64 32
# MEDICAL_IDEMPOTENCY_RETENTION_HOURS=72
#
# Deterministic Playwright auth fixtures (never enable in production)
# AUTH_E2E_FIXTURES=true
