{
  "name": "@diabetes-universe/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "test": "tsx --import ./scripts/test-register.mjs --test 'components/**/*.test.mjs' 'lib/**/*.test.mjs' 'proxy.test.mjs'",
    "test:dashboard-header": "node --no-warnings --experimental-strip-types --import ./scripts/test-register.mjs --test components/dashboard/dashboard-header-model.test.mjs",
    "test:dashboard-day-summary": "node --no-warnings --experimental-strip-types --import ./scripts/test-register.mjs --test components/dashboard/dashboard-day-summary-model.test.mjs",
    "test:dashboard-last-glucose": "node --no-warnings --experimental-strip-types --import ./scripts/test-register.mjs --test components/dashboard/dashboard-last-glucose-model.test.mjs",
    "test:dashboard-ai-insight": "node --no-warnings --experimental-strip-types --import ./scripts/test-register.mjs --test components/dashboard/dashboard-ai-insight-model.test.mjs",
    "test:dashboard-next-action": "node --no-warnings --experimental-strip-types --import ./scripts/test-register.mjs --test components/dashboard/dashboard-next-action-model.test.mjs",
    "test:dashboard-quick-add": "node --no-warnings --experimental-strip-types --import ./scripts/test-register.mjs --test lib/dashboard/dashboard-quick-add-integration-model.test.mjs lib/quick-add/quick-add-controller-model.test.mjs",
    "test:dashboard-recent-events": "node --no-warnings --experimental-strip-types --import ./scripts/test-register.mjs --test components/dashboard/dashboard-recent-events-model.test.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@diabetes-universe/formatting": "workspace:*",
    "@diabetes-universe/i18n": "workspace:*",
    "@diabetes-universe/identity": "workspace:*",
    "@diabetes-universe/platform": "workspace:*",
    "@diabetes-universe/platform-web": "workspace:*",
    "@diabetes-universe/timeline": "workspace:*",
    "@diabetes-universe/timeline-web": "workspace:*",
    "@diabetes-universe/types": "workspace:*",
    "@diabetes-universe/ui": "workspace:*",
    "better-auth": "1.6.29",
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.11.2",
    "tsx": "^4.23.12"
  }
}
