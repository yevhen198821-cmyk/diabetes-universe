{
  "name": "@diabetes-universe/medical-persistence",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./pglite-bootstrap": "./src/server/database/medical-pglite-bootstrap-migrations.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:smoke:privileges": "node ./scripts/live-privilege-smoke.mjs",
    "test": "node --no-warnings --experimental-strip-types --import ./scripts/test-register.mjs --test 'src/**/*.test.mjs'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@diabetes-universe/medical-domain": "workspace:*",
    "@diabetes-universe/types": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.4.0",
    "drizzle-kit": "0.31.10"
  }
}
